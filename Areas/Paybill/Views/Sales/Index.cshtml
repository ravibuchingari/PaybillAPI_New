@model List<SalesVM>
@{
    ViewData["Title"] = "Sales Invoices Register";
    string fromDate = ViewBag.FromDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string toDate = ViewBag.ToDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    bool isAdmin = ViewBag.IsAdmin is bool b && b;

    double totalSales = Model.Sum(s => s.TotalInvoiceAmount);
    double totalTax = Model.Sum(s => s.TotalCgst + s.TotalSgst + s.TotalIgst);
    double totalReceived = Model.Sum(s => s.ReceivedAmount);
    double totalBalance = Model.Sum(s => s.BalanceAmount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm" style="width: auto;">
            <span class="input-group-text">From</span>
            <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            <span class="input-group-text">To</span>
            <input type="date" name="toDate" value="@toDate" class="form-control" />
            <button type="submit" class="btn btn-paybill"><i class="bi bi-funnel me-1"></i>Load Invoices</button>
        </div>
        <a href="@Url.Action("Index", new { fromDate = DateTime.Today.ToString("yyyy-MM-dd"), toDate = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-outline-secondary">Today</a>
        <a href="@Url.Action("Index", new { fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"), toDate = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-outline-secondary">This Month</a>
    </form>

    <div class="d-flex gap-2">
        <a href="@Url.Action("SalesDetails", "Report", new { fromDate, toDate })" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Detailed Sales Report
        </a>
        <a href="@Url.Action("Create")" class="btn btn-paybill">
            <i class="bi bi-plus-circle me-1"></i>New Sales Invoice (POS)
        </a>
    </div>
</div>

<!-- KPI Summary Row -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Total Sales (@Model.Count Bills)</div>
            <div class="kpi-value text-success">₹ @totalSales.ToString("N2")</div>
            <div class="kpi-sub">Period: @fromDate to @toDate</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Total GST Collected</div>
            <div class="kpi-value text-primary">₹ @totalTax.ToString("N2")</div>
            <div class="kpi-sub">CGST + SGST + IGST</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Amount Collected</div>
            <div class="kpi-value">₹ @totalReceived.ToString("N2")</div>
            <div class="kpi-sub">Cash / UPI / Card</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">Credit / Balance Due</div>
            <div class="kpi-value text-danger">₹ @totalBalance.ToString("N2")</div>
            <div class="kpi-sub">Pending Customer Receivables</div>
        </div>
    </div>
</div>

<div class="pb-card">
    <div class="pb-card-header">
        <h6 class="pb-card-title"><i class="bi bi-receipt-cutoff me-2 text-success"></i>Sales Invoices</h6>
        <div class="d-flex gap-2">
            <input type="text" id="salesSearch" class="form-control form-control-sm" placeholder="Search invoice #, customer, mobile..." style="width: 250px;"
                   onkeyup="PaybillUI.filterTable('salesSearch', 'salesTable')" />
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PaybillUI.exportTableToCsv('salesTable', 'Sales_Register_@(fromDate)_@(toDate).csv')">
                <i class="bi bi-download me-1"></i>CSV
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0" id="salesTable">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Mode</th>
                    <th class="text-end">Tax (₹)</th>
                    <th class="text-end">Net Amount</th>
                    <th class="text-end">Balance</th>
                    <th class="text-center">Lock</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center py-5 text-muted">No sales invoices found for the selected dates.</td></tr>
                }
                @foreach (var s in Model)
                {
                    double tax = s.TotalCgst + s.TotalSgst + s.TotalIgst;
                    <tr>
                        <td class="fw-bold">
                            <a href="@Url.Action("Create", new { id = s.SalesId })" class="text-decoration-none">
                                #@(string.IsNullOrWhiteSpace(s.InvoiceNumber) ? s.SalesId.ToString() : s.InvoiceNumber)
                            </a>
                        </td>
                        <td>@s.SalesDate</td>
                        <td>
                            <div class="fw-medium">@(string.IsNullOrWhiteSpace(s.Party?.PartyName) ? "Walk-in Customer" : s.Party.PartyName)</div>
                            @if (!string.IsNullOrWhiteSpace(s.Party?.Mobile))
                            {
                                <div class="small text-muted">@s.Party.Mobile</div>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@s.SalesType</span></td>
                        <td>
                            <span class="badge-soft @(s.PaymentMode == "Credit" ? "badge-soft-warning" : "badge-soft-success")">
                                @s.PaymentMode
                            </span>
                        </td>
                        <td class="text-end">₹ @tax.ToString("N2")</td>
                        <td class="text-end fw-bold">₹ @s.TotalInvoiceAmount.ToString("N2")</td>
                        <td class="text-end @(s.BalanceAmount > 0 ? "text-danger fw-semibold" : "text-muted")">
                            ₹ @s.BalanceAmount.ToString("N2")
                        </td>
                        <td class="text-center">
                            @if (s.IsLocked)
                            {
                                <span class="badge bg-secondary-subtle text-secondary" title="Invoice is locked after creation/printing">
                                    <i class="bi bi-lock-fill"></i> Locked
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">
                                    <i class="bi bi-unlock-fill"></i> Open
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="@Url.Action("Create", new { id = s.SalesId })" class="btn btn-outline-primary" title="View / Edit Invoice">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="@Url.Action("Print", new { id = s.SalesId, format = "A4" })" target="_blank" class="btn btn-outline-success" title="Print A4 Invoice">
                                    <i class="bi bi-printer"></i>
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" target="_blank" href="@Url.Action("Print", new { id = s.SalesId, format = "A4" })"><i class="bi bi-file-earmark-pdf me-2"></i>Print A4 Tax Invoice</a></li>
                                    <li><a class="dropdown-item" target="_blank" href="@Url.Action("Print", new { id = s.SalesId, format = "A4_NONGST" })"><i class="bi bi-file-text me-2"></i>Print A4 Estimate / Non-GST</a></li>
                                    <li><a class="dropdown-item" target="_blank" href="@Url.Action("Print", new { id = s.SalesId, format = "POS80" })"><i class="bi bi-receipt me-2"></i>Print 80mm Thermal POS</a></li>
                                    <li><a class="dropdown-item" target="_blank" href="@Url.Action("Print", new { id = s.SalesId, format = "POS58" })"><i class="bi bi-receipt-cutoff me-2"></i>Print 58mm Thermal POS</a></li>
                                    @if (s.IsLocked)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-warning" onclick="openUnlockModal(@s.SalesId, '@(s.InvoiceNumber ?? s.SalesId.ToString())')">
                                                <i class="bi bi-unlock me-2"></i>Request Invoice Unlock
                                            </button>
                                        </li>
                                    }
                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" onclick="openDeleteInvoiceModal(@s.SalesId, '@(s.InvoiceNumber ?? s.SalesId.ToString())')">
                                                <i class="bi bi-trash me-2"></i>Delete / Cancel Invoice
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Unlock Request Modal -->
<div class="modal fade" id="unlockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RequestUnlock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="salesId" id="UnlockSalesId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-unlock me-2 text-warning"></i>Request Invoice Unlock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Requesting unlock for Invoice <strong id="UnlockInvoiceLabel"></strong>. Once approved by an Administrator, you can delete or modify items.</p>
                    <label class="form-label">Reason for Unlock Request *</label>
                    <textarea name="remarks" class="form-control" rows="3" required placeholder="e.g. Customer returned item / quantity correction required"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Submit Unlock Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Invoice Modal -->
<div class="modal fade" id="deleteInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="DeleteInvoice" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="DeleteSalesId" />
                <input type="hidden" name="fromDate" value="@fromDate" />
                <input type="hidden" name="toDate" value="@toDate" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small">Are you sure you want to delete Invoice <strong id="DeleteInvoiceLabel"></strong>? Stock quantities will be restored and deleted items will be logged in the Audit Report.</p>
                    <label class="form-label">Audit Remarks / Cancellation Reason *</label>
                    <input type="text" name="remarks" class="form-control" required placeholder="e.g. Duplicate entry / Cancelled by customer" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openUnlockModal(salesId, invNo) {
            document.getElementById('UnlockSalesId').value = salesId;
            document.getElementById('UnlockInvoiceLabel').innerText = '#' + invNo;
            new bootstrap.Modal(document.getElementById('unlockModal')).show();
        }
        function openDeleteInvoiceModal(salesId, invNo) {
            document.getElementById('DeleteSalesId').value = salesId;
            document.getElementById('DeleteInvoiceLabel').innerText = '#' + invNo;
            new bootstrap.Modal(document.getElementById('deleteInvoiceModal')).show();
        }
    </script>
}

