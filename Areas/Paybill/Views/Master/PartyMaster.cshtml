@model PartyMasterPageViewModel
@{
    bool isEdit = Model.IsEditMode;
    bool isVendor = Model.Party.IsVendor;
    string entityLabel = isVendor ? "Vendor / Supplier" : "Customer";
    ViewData["Title"] = isEdit ? $"Edit {entityLabel} — {Model.Party.PartyName}" : "Party / Vendor Master Registration";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Master")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Master Hub
        </a>
        <span class="text-muted">/</span>
        <span class="fw-semibold">@(isEdit ? $"Update {entityLabel} (#{Model.Party.PartyId})" : "Party / Vendor Registration")</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Party", new { isVendor = false })" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-people me-1"></i>View Customers (@Model.TotalCustomersCount)
        </a>
        <a href="@Url.Action("Index", "Party", new { isVendor = true })" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-buildings me-1"></i>View Vendors (@Model.TotalVendorsCount)
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Party / Vendor Registration Form (Matches PartyMasterScreen.kt) -->
    <div class="@(isEdit && !isVendor ? "col-lg-6" : "col-lg-8 mx-auto")">
        <div class="pb-card">
            <div class="pb-card-header">
                <h6 class="fw-bold mb-0">
                    <i class="bi @(isVendor ? "bi-buildings-fill text-warning" : "bi-person-Lines-fill text-primary") me-2"></i>
                    @(isEdit ? $"Update {entityLabel} Details" : "New Customer / Vendor Registration")
                </h6>
                <span class="badge @(isEdit ? "bg-warning text-dark" : "bg-primary")">
                    @(isEdit ? $"ID #{Model.Party.PartyId}" : "New Record")
                </span>
            </div>
            <div class="pb-card-body">
                <form asp-action="SaveParty" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PartyId" value="@Model.Party.PartyId" />
                    <input type="hidden" name="afterAction" id="partyAfterAction" value="stay" />

                    <!-- Party Type Selector (Radio Toggle: Customer vs Vendor, locked when editing) -->
                    <div class="mb-3 p-3 rounded-3 bg-light border">
                        <label class="form-label fw-bold mb-2 d-block">Registration Type <span class="text-danger">*</span></label>
                        @if (isEdit)
                        {
                            <input type="hidden" name="IsVendor" value="@(isVendor ? "true" : "false")" />
                        }
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="IsVendor"
                                       id="typeCustomer"
                                       value="false"
                                       @(!isVendor ? "checked" : "")
                                       @(isEdit ? "disabled" : "")
                                       onchange="updatePartyLabels(false)" />
                                <label class="form-check-label fw-semibold" for="typeCustomer">
                                    <i class="bi bi-person-check-fill text-primary me-1"></i>Customer (Buyer / Service Client)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="IsVendor"
                                       id="typeVendor"
                                       value="true"
                                       @(isVendor ? "checked" : "")
                                       @(isEdit ? "disabled" : "")
                                       onchange="updatePartyLabels(true)" />
                                <label class="form-check-label fw-semibold" for="typeVendor">
                                    <i class="bi bi-truck text-warning me-1"></i>Vendor / Supplier
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold" id="partyNameLabel">@entityLabel Name <span class="text-danger">*</span></label>
                            <input type="text"
                                   name="PartyName"
                                   value="@Model.Party.PartyName"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   placeholder="Enter full name or business name" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Mobile Number (10 digits) <span class="text-danger">*</span></label>
                            <input type="tel"
                                   name="PartyMobile"
                                   value="@Model.Party.PartyMobile"
                                   class="form-control"
                                   maxlength="10"
                                   pattern="[0-9]{10}"
                                   required
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);"
                                   placeholder="10-digit mobile number" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email"
                                   name="PartyEmail"
                                   value="@Model.Party.PartyEmail"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="customer@example.com" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">GSTIN Number (15 chars)</label>
                            <input type="text"
                                   name="PartyGstNo"
                                   value="@Model.Party.PartyGstNo"
                                   class="form-control text-uppercase font-monospace"
                                   maxlength="15"
                                   oninput="this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 15);"
                                   placeholder="e.g., 36AAAAA0000A1Z5" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Billing Address <span class="text-danger">*</span></label>
                            <textarea name="PartyAddress"
                                      id="billingAddrInput"
                                      class="form-control"
                                      rows="2"
                                      maxlength="250"
                                      required
                                      placeholder="Door No, Street, City, State, PIN">@Model.Party.PartyAddress</textarea>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label fw-semibold mb-1">Shipping Address</label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="document.getElementById('shippingAddrInput').value = document.getElementById('billingAddrInput').value;">
                                    Copy Billing
                                </button>
                            </div>
                            <textarea name="PartyShippingAddress"
                                      id="shippingAddrInput"
                                      class="form-control"
                                      rows="2"
                                      maxlength="250"
                                      placeholder="Delivery / Shipping address">@Model.Party.PartyShippingAddress</textarea>
                        </div>

                        <div class="col-md-9">
                            <label class="form-label fw-semibold">Remarks / Notes</label>
                            <input type="text"
                                   name="PartyRemarks"
                                   value="@Model.Party.PartyRemarks"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Credit terms, reference, or internal notes" />
                        </div>

                        <div class="col-md-3 d-flex align-items-end pb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="partyActiveSwitch" name="IsActive" value="true" @(Model.Party.IsActive ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="partyActiveSwitch">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4 pt-2 border-top">
                        <button type="submit" class="btn btn-primary" onclick="document.getElementById('partyAfterAction').value='stay'">
                            <i class="bi bi-check2-circle me-1"></i>@(isEdit ? $"Update {entityLabel}" : "Save & Register Another")
                        </button>
                        <button type="submit" class="btn btn-outline-primary" onclick="document.getElementById('partyAfterAction').value='list'">
                            <i class="bi bi-list-ul me-1"></i>@(isEdit ? "Update & View List" : "Save & View List")
                        </button>
                        <a href="@Url.Action("PartyMaster", "Master", new { id = 0, isVendor })" class="btn btn-outline-secondary ms-auto">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer Rewards Points Card (Displayed when editing a Customer, matching PartyMasterScreen.kt!) -->
    @if (isEdit && !isVendor)
    {
        var summary = Model.RewardsSummary;
        <div class="col-lg-6">
            <div class="pb-card mb-4 border-primary">
                <div class="pb-card-header bg-primary bg-opacity-10">
                    <h6 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-gift-fill me-2"></i>Customer Rewards Points
                    </h6>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-xs btn-primary" data-bs-toggle="modal" data-bs-target="#adjustCustomerPtsModal">
                            <i class="bi bi-plus-slash-minus me-1"></i>Adjust Points
                        </button>
                        <a href="@Url.Action("Ledger", "Party", new { id = Model.Party.PartyId })" class="btn btn-xs btn-outline-secondary">
                            <i class="bi bi-journal-text me-1"></i>Account Ledger
                        </a>
                    </div>
                </div>
                <div class="pb-card-body">
                    <div class="row g-3 text-center mb-3">
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <div class="small text-muted">Available Balance</div>
                                <div class="fw-bold fs-5 text-primary">@Model.AvailableRewardPoints.ToString("N0") pts</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <div class="small text-muted">Monetary Value</div>
                                <div class="fw-bold fs-5 text-success">₹@Model.RewardPointMonetaryValue.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <div class="small text-muted">Total Earned</div>
                                <div class="fw-semibold text-success">+@((summary?.TotalPointsEarned ?? 0).ToString("N0"))</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 rounded bg-light border">
                                <div class="small text-muted">Total Redeemed</div>
                                <div class="fw-semibold text-danger">-@((summary?.TotalPointsRedeemed ?? 0).ToString("N0"))</div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Rewards Transaction History (@Model.RewardTransactions.Count)</h6>
                    <div class="table-responsive" style="max-height: 290px;">
                        <table class="table table-sm pb-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Invoice</th>
                                    <th class="text-end">Points</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RewardTransactions.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted small">
                                            No reward point transactions recorded for this customer yet.
                                        </td>
                                    </tr>
                                }
                                @foreach (var tx in Model.RewardTransactions)
                                {
                                    <tr>
                                        <td class="small">@tx.TransactionDate</td>
                                        <td>
                                            <span class="badge @(tx.Points >= 0 ? "bg-success" : "bg-warning text-dark")">@tx.TransactionType</span>
                                        </td>
                                        <td class="small">@(string.IsNullOrWhiteSpace(tx.InvoiceNumber) ? "—" : $"#{tx.InvoiceNumber}")</td>
                                        <td class="text-end fw-bold @(tx.Points >= 0 ? "text-success" : "text-danger")">
                                            @(tx.Points >= 0 ? "+" : "")@tx.Points.ToString("N0")
                                        </td>
                                        <td class="small text-muted">@tx.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manual Points Adjustment Modal -->
        <div class="modal fade" id="adjustCustomerPtsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="AdjustCustomerRewardPoints" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="partyId" value="@Model.Party.PartyId" />
                        <div class="modal-header">
                            <h6 class="modal-title fw-bold">Adjust Reward Points — @Model.Party.PartyName</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Points to Add or Deduct <span class="text-danger">*</span></label>
                                <input type="number" step="1" name="points" class="form-control" placeholder="e.g., 50 to add, -25 to deduct" required />
                                <div class="form-text">Use positive numbers to credit bonus points or negative numbers to deduct points.</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-semibold">Reason / Remarks <span class="text-danger">*</span></label>
                                <input type="text" name="reason" class="form-control" placeholder="e.g., Promotional loyalty bonus" required />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary">Save Points Adjustment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updatePartyLabels(isVendor) {
            document.getElementById('partyNameLabel').innerHTML = (isVendor ? 'Vendor / Supplier Name' : 'Customer Name') + ' <span class="text-danger">*</span>';
        }
    </script>
}

