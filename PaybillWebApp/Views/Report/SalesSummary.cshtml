@model List<SalesSummary>
@{
    string fromDate = ViewBag.FromDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string toDate = ViewBag.ToDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string? salesType = ViewBag.SalesType as string;
    string? paymentMode = ViewBag.PaymentMode as string;
    ViewData["Title"] = "Sales Summary Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm" style="width: auto;">
            <span class="input-group-text">From</span>
            <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            <span class="input-group-text">To</span>
            <input type="date" name="toDate" value="@toDate" class="form-control" />
            <button type="submit" class="btn btn-paybill">Filter</button>
        </div>
    </form>

    <div class="d-flex gap-2">
        <a href="@Url.Action("DownloadSalesSummaryExcel", new { fromDate, toDate, salesType, paymentMode })" class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Download Official Excel (.xlsx)
        </a>
        <a href="@Url.Action("SalesDetails", new { fromDate, toDate, salesType, paymentMode })" class="btn btn-sm btn-outline-primary">
            Switch to Detailed Item View
        </a>
    </div>
</div>

<div class="pb-card">
    <div class="pb-card-header">
        <h6 class="pb-card-title">Sales Summary (@Model.Count Invoices | Total: ₹ @Model.Sum(m => m.TotalInvoiceAmount).ToString("N2"))</h6>
    </div>
    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>GSTIN</th>
                    <th>Mode</th>
                    <th class="text-end">Taxable</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">Disc</th>
                    <th class="text-end">Total Amt</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="12" class="text-center py-5 text-muted">No sales summary data found.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold">#@s.InvoiceNumber</td>
                        <td>@s.SalesDate</td>
                        <td>@(string.IsNullOrWhiteSpace(s.PartyName) ? "Walk-in" : s.PartyName)</td>
                        <td class="font-monospace small">@s.Gstin</td>
                        <td>@s.PaymentMode</td>
                        <td class="text-end">₹ @s.TotalTaxableAmount.ToString("N2")</td>
                        <td class="text-end">₹ @s.TotalCgst.ToString("N2")</td>
                        <td class="text-end">₹ @s.TotalSgst.ToString("N2")</td>
                        <td class="text-end">₹ @s.TotalIgst.ToString("N2")</td>
                        <td class="text-end">₹ @s.TotalDiscount.ToString("N2")</td>
                        <td class="text-end fw-bold">₹ @s.TotalInvoiceAmount.ToString("N2")</td>
                        <td class="text-end @(s.BalanceAmount > 0 ? "text-danger" : "")">₹ @s.BalanceAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

