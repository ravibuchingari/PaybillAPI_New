@model PartyPageViewModel
@using PaybillWebApp.Helpers
@{
    string entityTitle = Model.IsVendor ? "Suppliers & Vendors" : "Customers";
    string entitySingular = Model.IsVendor ? "Supplier" : "Customer";
    ViewData["Title"] = $"{entityTitle} Directory";

    double totalBalance = 0;
    foreach (var p in Model.Parties)
    {
        if (Model.BalanceMap.TryGetValue(p.PartyId, out var bs))
            totalBalance += bs.ClosingBalance;
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="btn-group me-3">
            <a href="@Url.Action("Index", new { isVendor = false })" class="btn @(Model.IsVendor ? "btn-outline-paybill" : "btn-paybill")">
                <i class="bi bi-people me-1"></i>Customers
            </a>
            <a href="@Url.Action("Index", new { isVendor = true })" class="btn @(Model.IsVendor ? "btn-paybill" : "btn-outline-paybill")">
                <i class="bi bi-building me-1"></i>Suppliers / Vendors
            </a>
        </div>
        <span class="text-muted small">Manage @entityTitle.ToLower(), GSTIN details, opening balances, and ledgers.</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("BalanceSheet", "Report")" class="btn btn-outline-secondary">
            <i class="bi bi-journal-check me-1"></i>Balance Sheet Report
        </a>
        <button type="button" class="btn btn-paybill" onclick="openPartyModal()">
            <i class="bi bi-person-plus-fill me-1"></i>Add @entitySingular
        </button>
    </div>
</div>

<!-- Summary KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">Total @entityTitle</div>
            <div class="kpi-value">@Model.Parties.Count</div>
            <div class="kpi-sub text-success">@Model.Parties.Count(p => p.IsActive) Active Accounts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">GST Registered @entityTitle</div>
            <div class="kpi-value">@Model.Parties.Count(p => !string.IsNullOrWhiteSpace(p.Gstin))</div>
            <div class="kpi-sub">B2B GSTIN Verified Accounts</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">Total @(Model.IsVendor ? "Payable Balance" : "Receivable Balance")</div>
            <div class="kpi-value @(Model.IsVendor ? "text-danger" : "text-primary")">₹ @totalBalance.ToString("N2")</div>
            <div class="kpi-sub">Net Closing Balance</div>
        </div>
    </div>
</div>

<div class="pb-card">
    <div class="pb-card-header">
        <h6 class="pb-card-title"><i class="bi @(Model.IsVendor ? "bi-building" : "bi-people-fill") me-2 text-success"></i>@entityTitle Master List</h6>
        <div class="d-flex gap-2">
            <input type="text" id="partySearch" class="form-control form-control-sm" placeholder="Search name, mobile, GSTIN..." style="width: 250px;"
                   onkeyup="PaybillUI.filterTable('partySearch', 'partyTable')" />
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PaybillUI.exportTableToCsv('partyTable', '@(entityTitle)_List.csv')">
                <i class="bi bi-download me-1"></i>CSV
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0" id="partyTable">
            <thead>
                <tr>
                    <th>@entitySingular Name</th>
                    <th>Mobile / Contact</th>
                    <th>GSTIN & State</th>
                    <th>Address</th>
                    <th class="text-end">Opening Bal</th>
                    <th class="text-end">Current Balance</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Parties.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted">No @entityTitle.ToLower() found. Click "Add @entitySingular" to create one.</td></tr>
                }
                @foreach (var p in Model.Parties)
                {
                    Model.BalanceMap.TryGetValue(p.PartyId, out var bal);
                    double closingBal = bal?.ClosingBalance ?? p.OpeningBalance;
                    string stateName = GstHelper.GetStateNameFromGstin(p.Gstin);
                    <tr>
                        <td>
                            <div class="fw-semibold">@p.PartyName</div>
                            @if (!string.IsNullOrWhiteSpace(p.Email))
                            {
                                <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@p.Email</div>
                            }
                        </td>
                        <td>
                            <span class="fw-medium"><i class="bi bi-telephone text-success me-1"></i>@p.Mobile</span>
                            @if (!string.IsNullOrWhiteSpace(p.Phone))
                            {
                                <div class="small text-muted">Alt: @p.Phone</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.Gstin))
                            {
                                <span class="badge bg-primary-subtle text-primary font-monospace">@p.Gstin</span>
                                @if (!string.IsNullOrWhiteSpace(stateName))
                                {
                                    <div class="small text-muted mt-1">@stateName</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Unregistered</span>
                            }
                        </td>
                        <td class="small text-muted" style="max-width: 220px;">@(string.IsNullOrWhiteSpace(p.Address) ? "—" : p.Address)</td>
                        <td class="text-end">₹ @p.OpeningBalance.ToString("N2")</td>
                        <td class="text-end fw-bold @(closingBal > 0 ? (Model.IsVendor ? "text-danger" : "text-primary") : "text-success")">
                            ₹ @closingBal.ToString("N2")
                        </td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge-soft badge-soft-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="@Url.Action("Ledger", new { id = p.PartyId })" class="btn btn-outline-success" title="View Ledger Statement">
                                    <i class="bi bi-journal-text me-1"></i>Ledger
                                </a>
                                <button type="button" class="btn btn-outline-primary" title="Quick @(Model.IsVendor ? "Payment" : "Receipt")"
                                        onclick="openQuickTxModal(@p.PartyId, '@Html.Raw(p.PartyName.Replace("'", "\\'"))', @closingBal)">
                                    <i class="bi bi-cash-coin"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" title="Edit"
                                        onclick='editParty(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(p)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="DeleteParty" method="post" class="d-inline" onsubmit="return confirm('Delete this @entitySingular.ToLower()?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.PartyId" />
                                    <input type="hidden" name="isVendor" value="@Model.IsVendor.ToString().ToLower()" />
                                    <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add / Edit Party Modal -->
<div class="modal fade" id="partyModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SaveParty" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PartyId" id="PartyId" value="0" />
                <input type="hidden" name="IsVendor" value="@Model.IsVendor.ToString().ToLower()" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="partyModalTitle">Add @entitySingular</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@entitySingular Name *</label>
                            <input type="text" name="PartyName" id="PartyName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mobile Number *</label>
                            <input type="text" name="Mobile" id="Mobile" class="form-control" maxlength="15" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Alternate Phone</label>
                            <input type="text" name="Phone" id="Phone" class="form-control" maxlength="15" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" id="Email" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">GSTIN (15 Digits)</label>
                            <input type="text" name="Gstin" id="Gstin" class="form-control text-uppercase font-monospace" maxlength="15" placeholder="e.g. 29ABCDE1234F1Z5" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Billing Address</label>
                            <input type="text" name="Address" id="Address" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Opening Balance (₹)</label>
                            <input type="number" step="0.01" name="OpeningBalance" id="OpeningBalance" class="form-control" value="0" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Remarks / Notes</label>
                            <input type="text" name="Remarks" id="Remarks" class="form-control" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="PartyIsActive" value="true" checked />
                                <label class="form-check-label" for="PartyIsActive">Active Account</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-paybill"><i class="bi bi-check2-circle me-1"></i>Save @entitySingular</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quick Payment / Receipt Modal -->
<div class="modal fade" id="quickTxModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Transaction" asp-action="SaveTransaction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PartyId" id="TxPartyId" />
                <input type="hidden" name="IsPayment" value="@Model.IsVendor.ToString().ToLower()" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Record @(Model.IsVendor ? "Supplier Payment (Out)" : "Customer Receipt (In)")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@entitySingular</label>
                        <input type="text" id="TxPartyName" class="form-control bg-light" readonly />
                        <div class="form-text" id="TxCurrentBalanceInfo"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Date *</label>
                            <input type="date" name="TransactionDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Payment Mode *</label>
                            <select name="PaymentMode" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Bank Transfer / NEFT</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount @(Model.IsVendor ? "Paid" : "Received") (₹) *</label>
                            <input type="number" step="0.01" min="0.01" name="@(Model.IsVendor ? "PaidAmount" : "ReceivedAmount")" id="TxAmount" class="form-control fw-bold" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Discount Allowed (₹)</label>
                            <input type="number" step="0.01" min="0" name="Discount" class="form-control" value="0" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks / Reference No.</label>
                            <input type="text" name="Remarks" class="form-control" placeholder="e.g. UPI Ref / Bill Settlement" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-paybill"><i class="bi bi-check2-circle me-1"></i>Save @(Model.IsVendor ? "Payment" : "Receipt")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPartyModal() {
            document.getElementById('partyModalTitle').innerText = 'Add @entitySingular';
            document.getElementById('PartyId').value = 0;
            document.getElementById('PartyName').value = '';
            document.getElementById('Mobile').value = '';
            document.getElementById('Phone').value = '';
            document.getElementById('Email').value = '';
            document.getElementById('Gstin').value = '';
            document.getElementById('Address').value = '';
            document.getElementById('OpeningBalance').value = 0;
            document.getElementById('Remarks').value = '';
            document.getElementById('PartyIsActive').checked = true;
            new bootstrap.Modal(document.getElementById('partyModal')).show();
        }

        function editParty(p) {
            document.getElementById('partyModalTitle').innerText = 'Edit @entitySingular: ' + p.PartyName;
            document.getElementById('PartyId').value = p.PartyId;
            document.getElementById('PartyName').value = p.PartyName || '';
            document.getElementById('Mobile').value = p.Mobile || '';
            document.getElementById('Phone').value = p.Phone || '';
            document.getElementById('Email').value = p.Email || '';
            document.getElementById('Gstin').value = p.Gstin || '';
            document.getElementById('Address').value = p.Address || '';
            document.getElementById('OpeningBalance').value = p.OpeningBalance || 0;
            document.getElementById('Remarks').value = p.Remarks || '';
            document.getElementById('PartyIsActive').checked = !!p.IsActive;
            new bootstrap.Modal(document.getElementById('partyModal')).show();
        }

        function openQuickTxModal(partyId, partyName, balance) {
            document.getElementById('TxPartyId').value = partyId;
            document.getElementById('TxPartyName').value = partyName;
            document.getElementById('TxCurrentBalanceInfo').innerText = 'Current Outstanding Balance: ₹ ' + Number(balance).toFixed(2);
            document.getElementById('TxAmount').value = balance > 0 ? Number(balance).toFixed(2) : '';
            new bootstrap.Modal(document.getElementById('quickTxModal')).show();
        }
    </script>
}

