@{
    ViewData["Title"] = "Access Denied";
}
<div class="pb-card p-5 text-center my-4">
    <i class="bi bi-shield-lock-fill text-danger display-3"></i>
    <h3 class="fw-bold mt-3">Administrator Access Required</h3>
    <p class="text-muted">You do not have sufficient permissions to perform this operation. Please sign in with an Administrator account.</p>
    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary mt-2">
        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
    </a>
</div>

