@model SetupAccountViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initial Business Setup | PayBill Cloud ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #121512 0%, #174204 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .setup-card {
            max-width: 680px;
            width: 100%;
            background: #fff;
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
        }
    </style>
</head>
<body>
    <div class="setup-card">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-1" style="color:#174204;">First-Time Business &amp; Admin Setup</h4>
                <p class="text-muted small mb-0">Initialize your PayBill business profile and administrator account</p>
            </div>
            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-secondary">Back to Login</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
        }

        <form asp-action="Setup" method="post">
            @Html.AntiForgeryToken()
            <h6 class="fw-bold text-uppercase small text-secondary border-bottom pb-2 mb-3">1. Business Profile</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label class="form-label small fw-semibold">Business / Company Name *</label>
                    <input asp-for="ClientName" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold">Business Category *</label>
                    <input asp-for="BusinessType" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Mobile Number (10 digits) *</label>
                    <input asp-for="Mobile" class="form-control" maxlength="10" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Business Address *</label>
                    <input asp-for="Address" class="form-control" required />
                </div>
            </div>

            <h6 class="fw-bold text-uppercase small text-secondary border-bottom pb-2 mb-3">2. Administrator Credentials</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">First Name *</label>
                    <input asp-for="AdminFirstName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Last Name *</label>
                    <input asp-for="AdminLastName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Admin User ID *</label>
                    <input asp-for="AdminUserId" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Admin Password *</label>
                    <input asp-for="AdminPassword" type="password" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-semibold py-2" style="background:#174204;border-color:#174204;">
                <i class="bi bi-check2-circle me-1"></i> Complete Setup &amp; Continue
            </button>
        </form>
    </div>
</body>
</html>

