@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - @Model.CompanyName | PayBill Cloud POS &amp; ERP</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #121512 0%, #174204 55%, #2c6e0a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .login-shell {
            max-width: 960px;
            width: 100%;
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
            display: flex;
        }
        .login-hero {
            background: linear-gradient(160deg, #174204 0%, #0d2602 100%);
            color: #fff;
            padding: 3rem 2.5rem;
            width: 46%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }
        .login-form-pane {
            padding: 3rem 2.75rem;
            width: 54%;
            background: #ffffff;
            color: #1c251c;
        }
        .btn-paybill {
            background-color: #174204;
            border-color: #174204;
            color: #fff;
            font-weight: 600;
            padding: 0.7rem 1.25rem;
            border-radius: 10px;
        }
        .btn-paybill:hover {
            background-color: #2c6e0a;
            border-color: #2c6e0a;
            color: #fff;
        }
        .feature-pill {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.85rem;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            margin-bottom: 0.65rem;
            font-size: 0.85rem;
        }
        .feature-pill i {
            color: #81c784;
            font-size: 1.1rem;
        }
        @@media (max-width: 767.98px) {
            .login-shell { flex-direction: column; }
            .login-hero, .login-form-pane { width: 100%; padding: 2rem; }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-hero">
            <div>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="~/images/logo.png" alt="PayBill" style="width:52px;height:52px;border-radius:12px;background:#fff;padding:4px;" onerror="this.style.display='none'" />
                    <div>
                        <h4 class="mb-0 fw-bold">PayBill ERP</h4>
                        <span class="badge" style="background:#81c784;color:#121512;">Web POS &amp; Business Suite</span>
                    </div>
                </div>
                <h3 class="fw-bold mb-2">@Model.CompanyName</h3>
                <p class="text-white-50 small mb-4">@Model.BusinessType — Manage billing, GST, inventory, job cards, parties, and analytics seamlessly from your browser.</p>

                <div class="feature-pill">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Fast POS Billing, Barcodes, UPI QR &amp; Thermal/A4 Print</span>
                </div>
                <div class="feature-pill">
                    <i class="bi bi-tools"></i>
                    <span>Service Job Cards &amp; One-Click Invoice Conversion</span>
                </div>
                <div class="feature-pill">
                    <i class="bi bi-bank2"></i>
                    <span>Indian GST Compliance (GSTR-1, 3B, 2A/2B, HSN/SAC &amp; JSON)</span>
                </div>
                <div class="feature-pill">
                    <i class="bi bi-gift-fill"></i>
                    <span>Customer Loyalty &amp; Reward Points Engine</span>
                </div>
            </div>
            <div class="small text-white-50 mt-3">
                <i class="bi bi-shield-lock-fill text-success me-1"></i> AES-256 &amp; JWT Protected Multi-User Access
            </div>
        </div>

        <div class="login-form-pane d-flex flex-column justify-content-center">
            <div class="mb-4">
                <h4 class="fw-bold mb-1">Welcome Back</h4>
                <p class="text-muted small mb-0">Sign in with your PayBill User ID and Password</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success py-2 small">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ErrorMessage
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClientUniqueId" />
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="CompanyName" />
                <input type="hidden" asp-for="BusinessType" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-semibold small text-uppercase">User ID</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person-fill text-secondary"></i></span>
                        <input asp-for="UserId" class="form-control" placeholder="Enter User ID (e.g., admin)" autofocus required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold small text-uppercase">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-secondary"></i></span>
                        <input asp-for="Password" type="password" id="loginPasswordInput" class="form-control" placeholder="Enter your password" required />
                        <button type="button" class="btn btn-outline-secondary" onclick="const p=document.getElementById('loginPasswordInput'); p.type = p.type==='password'?'text':'password';">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-paybill w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
                </button>

                @if (!Model.IsConfigured)
                {
                    <div class="text-center mt-2">
                        <a href="@Url.Action("Setup", "Account")" class="small text-decoration-none fw-semibold" style="color:#174204;">
                            <i class="bi bi-magic me-1"></i> First-time setup? Register Business Account
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>
</body>
</html>

