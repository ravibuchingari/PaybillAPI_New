@model CategoryMasterViewModel
@{
    ViewData["Title"] = "Category Master Registration";
    bool isEdit = Model.EditCategory.CategoryId > 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Master")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Master Hub
        </a>
        <span class="text-muted">/</span>
        <span class="fw-semibold">Category Master</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ItemMaster", "Master")" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-box-seam me-1"></i>+ Add New Item
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Category Registration Form (Matches SearchCategoryScreen.kt) -->
    <div class="col-lg-4">
        <div class="pb-card">
            <div class="pb-card-header">
                <h6 class="fw-bold mb-0">
                    <i class="bi @(isEdit ? "bi-pencil-square text-warning" : "bi-plus-circle-fill text-primary") me-2"></i>
                    @(isEdit ? $"Update Category (#{Model.EditCategory.CategoryId})" : "New Category Registration")
                </h6>
            </div>
            <div class="pb-card-body">
                <form asp-action="SaveCategory" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="categoryId" value="@Model.EditCategory.CategoryId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text"
                               name="categoryName"
                               value="@Model.EditCategory.CategoryName"
                               class="form-control"
                               maxlength="50"
                               required
                               autofocus
                               placeholder="e.g., Groceries, Electronics, Beverages" />
                        <div class="form-text">Maximum 50 characters. Must be unique.</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-check2-circle me-1"></i>@(isEdit ? "Update Category" : "Save Category")
                        </button>
                        <a href="@Url.Action("Categories", "Master")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Search & Category List -->
    <div class="col-lg-8">
        <div class="pb-card">
            <div class="pb-card-header flex-wrap gap-2">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-tags me-2 text-primary"></i>Registered Categories (@Model.Categories.Count)
                </h6>
                <form method="get" asp-action="Categories" class="d-flex gap-2">
                    <div class="input-group input-group-sm" style="width: 260px;">
                        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="@Model.SearchFilter" class="form-control" placeholder="Search category..." />
                        @if (!string.IsNullOrWhiteSpace(Model.SearchFilter))
                        {
                            <a href="@Url.Action("Categories", "Master")" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table pb-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 90px;">ID</th>
                            <th>Category Name</th>
                            <th class="text-center">Linked Items</th>
                            <th class="text-end" style="width: 170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Categories.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-tags fs-2 d-block mb-2"></i>
                                    No categories found. Use the form on the left to register your first category.
                                </td>
                            </tr>
                        }
                        @foreach (var cat in Model.Categories)
                        {
                            <tr class="@(Model.EditCategory.CategoryId == cat.CategoryId ? "table-primary" : "")">
                                <td class="text-muted fw-semibold">#@cat.CategoryId</td>
                                <td class="fw-bold">@cat.CategoryName</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Items", "Master", new { categoryId = cat.CategoryId })" class="badge bg-primary bg-opacity-10 text-primary text-decoration-none">
                                        @cat.ItemCount Items
                                    </a>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="@Url.Action("Categories", "Master", new { editId = cat.CategoryId, q = Model.SearchFilter })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Category">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="DeleteCategory" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete category \'@cat.CategoryName\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Category">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

