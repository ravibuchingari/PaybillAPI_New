@model GstMasterViewModel
@{
    ViewData["Title"] = "GST Master Registration";
    bool isEdit = Model.EditGst.GstId > 0;
    float initialTotal = Model.EditGst.IgstPer > 0 ? Model.EditGst.IgstPer : (Model.EditGst.CgstPer + Model.EditGst.SgstPer);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Master")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Master Hub
        </a>
        <span class="text-muted">/</span>
        <span class="fw-semibold">GST Master</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ItemMaster", "Master")" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-box-seam me-1"></i>+ Add New Item
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: GST Registration Form (Matches SearchGSTScreen.kt with auto-split CGST/SGST) -->
    <div class="col-lg-4">
        <div class="pb-card">
            <div class="pb-card-header">
                <h6 class="fw-bold mb-0">
                    <i class="bi @(isEdit ? "bi-pencil-square text-warning" : "bi-percent text-success") me-2"></i>
                    @(isEdit ? $"Update GST Slab (#{Model.EditGst.GstId})" : "New GST Slab Registration")
                </h6>
            </div>
            <div class="pb-card-body">
                <form asp-action="SaveGst" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="gstId" value="@Model.EditGst.GstId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Total GST / IGST (%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   id="igstInput"
                                   name="igstPer"
                                   value="@(initialTotal > 0 ? initialTotal.ToString("0.##") : "")"
                                   class="form-control fw-bold"
                                   placeholder="e.g., 5, 12, 18, 28"
                                   required
                                   oninput="splitGstRate(this.value)" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-text">Entering Total GST automatically splits equally into CGST and SGST.</div>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Quick GST Slab Presets:</label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var rate in new[] { 0f, 5f, 12f, 18f, 28f })
                            {
                                <button type="button" class="btn btn-xs btn-outline-secondary" onclick="setGstPreset(@rate)">@rate%</button>
                            }
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">CGST (%)</label>
                            <div class="input-group input-group-sm">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       id="cgstInput"
                                       name="cgstPer"
                                       value="@Model.EditGst.CgstPer.ToString("0.##")"
                                       class="form-control"
                                       required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">SGST (%)</label>
                            <div class="input-group input-group-sm">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       id="sgstInput"
                                       name="sgstPer"
                                       value="@Model.EditGst.SgstPer.ToString("0.##")"
                                       class="form-control"
                                       required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="gstActiveSwitch" name="isActive" value="true" @(Model.EditGst.IsActive ? "checked" : "") />
                        <label class="form-check-label fw-semibold" for="gstActiveSwitch">Active GST Slab</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">
                            <i class="bi bi-check2-circle me-1"></i>@(isEdit ? "Update GST" : "Save GST")
                        </button>
                        <a href="@Url.Action("Gst", "Master")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Registered GST Slabs List -->
    <div class="col-lg-8">
        <div class="pb-card">
            <div class="pb-card-header flex-wrap gap-2">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-percent me-2 text-success"></i>Registered GST Slabs (@Model.GstSlabs.Count)
                </h6>
                <form method="get" asp-action="Gst" class="d-flex gap-2">
                    <div class="input-group input-group-sm" style="width: 240px;">
                        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" value="@Model.SearchFilter" class="form-control" placeholder="Search GST %..." />
                        @if (!string.IsNullOrWhiteSpace(Model.SearchFilter))
                        {
                            <a href="@Url.Action("Gst", "Master")" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-success">Search</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table pb-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>GST Slab</th>
                            <th class="text-end">CGST %</th>
                            <th class="text-end">SGST %</th>
                            <th class="text-end">IGST %</th>
                            <th class="text-center">Status</th>
                            <th class="text-end" style="width: 160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.GstSlabs.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-percent fs-2 d-block mb-2"></i>
                                    No GST slabs registered yet.
                                </td>
                            </tr>
                        }
                        @foreach (var g in Model.GstSlabs)
                        {
                            float total = g.IgstPer > 0 ? g.IgstPer : (g.CgstPer + g.SgstPer);
                            <tr class="@(Model.EditGst.GstId == g.GstId ? "table-success" : "")">
                                <td class="fw-bold">GST @total.ToString("0.##")%</td>
                                <td class="text-end">@g.CgstPer.ToString("0.##")%</td>
                                <td class="text-end">@g.SgstPer.ToString("0.##")%</td>
                                <td class="text-end fw-semibold">@total.ToString("0.##")%</td>
                                <td class="text-center">
                                    <span class="badge @(g.IsActive ? "bg-success" : "bg-secondary")">
                                        @(g.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="@Url.Action("Gst", "Master", new { editId = g.GstId })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="DeleteGst" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete GST @total.ToString("0.##")% slab?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@g.GstId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function splitGstRate(val) {
            const total = parseFloat(val);
            if (!isNaN(total) && total >= 0) {
                const half = (total / 2).toFixed(2).replace(/\.00$/, '');
                document.getElementById('cgstInput').value = half;
                document.getElementById('sgstInput').value = half;
            }
        }
        function setGstPreset(rate) {
            const igst = document.getElementById('igstInput');
            igst.value = rate;
            splitGstRate(rate);
        }
    </script>
}

