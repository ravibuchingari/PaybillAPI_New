@model InventoryPageViewModel
@{
    ViewData["Title"] = "View All Items & Item Images";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Master")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Master Hub
        </a>
        <span class="text-muted">/</span>
        <span class="fw-semibold">View All Items (@Model.Items.Count)</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#allImagesGalleryModal">
            <i class="bi bi-images me-1"></i>All Item Images Gallery
        </button>
        <a href="@Url.Action("PrintBarcodes", "Inventory")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-qr-code me-1"></i>Print QR / Barcodes
        </a>
        <form asp-action="ResetStock" method="post" class="d-inline" onsubmit="return confirm('Recalculate closing stock for all items from opening stock, purchases, and sales?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-warning">
                <i class="bi bi-arrow-repeat me-1"></i>Reset Stock
            </button>
        </form>
        <a href="@Url.Action("ItemMaster", "Master")" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>+ Add New Item
        </a>
    </div>
</div>

<div class="pb-card">
    <div class="pb-card-header flex-wrap gap-2">
        <form method="get" asp-action="Items" class="d-flex flex-wrap gap-2 align-items-center w-100 justify-content-between">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <select name="categoryId" class="form-select form-select-sm" style="width: 210px;" onchange="this.form.submit()">
                    <option value="0">All Categories (@Model.Items.Count)</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.SelectedCategoryId == cat.CategoryId)
                        {
                            <option value="@cat.CategoryId" selected>@cat.CategoryName (@cat.ItemCount)</option>
                        }
                        else
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName (@cat.ItemCount)</option>
                        }
                    }
                </select>
                <div class="input-group input-group-sm" style="width: 300px;">
                    <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                    <input type="text" name="filter" value="@Model.SearchFilter" class="form-control" placeholder="Search name, code, alias, category..." />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchFilter) || Model.SelectedCategoryId > 0)
                    {
                        <a href="@Url.Action("Items", "Master")" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
            </div>
            <div class="small text-muted">
                Low Stock Alerts: <strong class="text-danger">@Model.MinStockItems.Count</strong>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;">Photo</th>
                    <th>Code</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th class="text-end">MRP (₹)</th>
                    <th class="text-end">Sales Price (₹)</th>
                    <th class="text-end">Purchase (₹)</th>
                    <th class="text-center">GST</th>
                    <th class="text-end">Closing Stock</th>
                    <th>Shelf</th>
                    <th class="text-center">Status</th>
                    <th class="text-end" style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="12" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                            No items found matching your criteria.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    bool isLow = item.ClosingStock <= item.MinimumStock;
                    string imgUrl = $"/images/items/{item.ItemId}.png";
                    <tr>
                        <td>
                            <div class="rounded border bg-light d-flex align-items-center justify-content-center overflow-hidden"
                                 style="width: 42px; height: 42px; cursor: pointer;"
                                 onclick="showItemPhotoModal('@imgUrl', '@Html.Raw(item.ItemName.Replace("'", "\\'"))', '@item.ItemCode')">
                                <img src="@imgUrl"
                                     alt="@item.ItemName"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';" />
                                <i class="bi bi-box-seam text-muted" style="display: none;"></i>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace">@item.ItemCode</span></td>
                        <td>
                            <div class="fw-bold">@item.ItemName</div>
                            @if (!string.IsNullOrWhiteSpace(item.ItemLocalName) && item.ItemLocalName != item.ItemName)
                            {
                                <div class="small text-muted">@item.ItemLocalName</div>
                            }
                        </td>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary">@(item.CategoryModel?.CategoryName ?? "—")</span></td>
                        <td class="text-end text-muted">₹@item.Mrp.ToString("N2")</td>
                        <td class="text-end fw-bold text-success">₹@item.SalesPrice.ToString("N2")</td>
                        <td class="text-end">₹@item.PurchasePrice.ToString("N2")</td>
                        <td class="text-center">
                            @if (item.GstModel != null)
                            {
                                float gTotal = item.GstModel.IgstPer > 0 ? item.GstModel.IgstPer : (item.GstModel.CgstPer + item.GstModel.SgstPer);
                                <span class="badge bg-success bg-opacity-10 text-success">@gTotal.ToString("0.##")%</span>
                            }
                            else
                            {
                                <span class="text-muted small">0%</span>
                            }
                        </td>
                        <td class="text-end">
                            <span class="fw-bold @(isLow ? "text-danger" : "text-dark")">
                                @item.ClosingStock.ToString("0.##") <small class="text-muted">@item.Measure</small>
                            </span>
                            @if (isLow)
                            {
                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Below minimum stock (@item.MinimumStock)"></i>
                            }
                        </td>
                        <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.Shelf) ? "—" : item.Shelf)</td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a href="@Url.Action("ItemMaster", "Master", new { id = item.ItemId })"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Edit Item in Item Master">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("PrintBarcodes", "Inventory", new { itemIds = item.ItemId.ToString(), copies = 4 })"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="Print Barcode Labels">
                                    <i class="bi bi-upc"></i>
                                </a>
                                <form asp-action="DeleteItem" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete item \'@item.ItemName\'?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Item">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Single Item Image Preview Modal -->
<div class="modal fade" id="itemPhotoPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="previewModalTitle">Item Photo</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="previewModalImg" src="" alt="Item Photo" class="img-fluid rounded shadow-sm" style="max-height: 360px;" />
            </div>
        </div>
    </div>
</div>

<!-- All Item Images Gallery Modal (Matches AllItemImagesActivity.kt) -->
<div class="modal fade" id="allImagesGalleryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-images text-info me-2"></i>All Item Images Gallery</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    @foreach (var item in Model.Items)
                    {
                        string imgUrl = $"/images/items/{item.ItemId}.png";
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2 item-gallery-card">
                            <div class="card h-100 shadow-sm">
                                <div class="p-2 bg-light text-center d-flex align-items-center justify-content-center" style="height: 120px;">
                                    <img src="@imgUrl"
                                         alt="@item.ItemName"
                                         class="img-fluid rounded"
                                         style="max-height: 105px; object-fit: contain;"
                                         onerror="this.closest('.item-gallery-card').style.display='none';" />
                                </div>
                                <div class="card-body p-2 text-center">
                                    <div class="small fw-bold text-truncate" title="@item.ItemName">@item.ItemName</div>
                                    <div class="text-success small fw-semibold">₹@item.SalesPrice.ToString("N2")</div>
                                    <a href="@Url.Action("ItemMaster", "Master", new { id = item.ItemId })" class="btn btn-xs btn-outline-primary mt-1 w-100">Edit</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showItemPhotoModal(url, name, code) {
            document.getElementById('previewModalTitle').textContent = `${name} (${code})`;
            document.getElementById('previewModalImg').src = url;
            new bootstrap.Modal(document.getElementById('itemPhotoPreviewModal')).show();
        }
    </script>
}

