@model List<TransactionVM>
@{
    var party = ViewBag.Party as PartyVM ?? new PartyVM();
    var header = ViewBag.PrintHeader as PrintHeader ?? new PrintHeader();
    string fromDate = ViewBag.FromDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string toDate = ViewBag.ToDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    ViewData["Title"] = $"Party Ledger — {party.PartyName}";

    double totalSalesOrPurchase = Model.Sum(t => t.InvoiceAmount);
    double totalReceivedOrPaid = Model.Sum(t => t.ReceivedAmount + t.PaidAmount);
    double totalDiscount = Model.Sum(t => t.Discount);
    double closingBalance = Model.LastOrDefault()?.BalanceAmount ?? party.OpeningBalance;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 no-print">
    <div>
        <a href="@Url.Action("Index", new { isVendor = party.IsVendor })" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i>Back to @(party.IsVendor ? "Suppliers" : "Customers")
        </a>
        <span class="fw-bold fs-5">@party.PartyName</span>
        @if (!string.IsNullOrWhiteSpace(party.Mobile))
        {
            <span class="badge bg-light text-dark border ms-2"><i class="bi bi-telephone me-1"></i>@party.Mobile</span>
        }
        @if (!string.IsNullOrWhiteSpace(party.Gstin))
        {
            <span class="badge bg-primary-subtle text-primary ms-1">GSTIN: @party.Gstin</span>
        }
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="id" value="@party.PartyId" />
            <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
            <span class="text-muted">to</span>
            <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-paybill"><i class="bi bi-funnel me-1"></i>Filter</button>
        </form>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PaybillUI.exportTableToCsv('ledgerTable', 'Ledger_@(party.PartyName).csv')">
            <i class="bi bi-download me-1"></i>CSV
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print Statement
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Opening Balance</div>
            <div class="kpi-value fs-4">₹ @party.OpeningBalance.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Total @(party.IsVendor ? "Purchases" : "Invoiced")</div>
            <div class="kpi-value fs-4 text-primary">₹ @totalSalesOrPurchase.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Total @(party.IsVendor ? "Paid" : "Received")</div>
            <div class="kpi-value fs-4 text-success">₹ @totalReceivedOrPaid.ToString("N2")</div>
            @if (totalDiscount > 0)
            {
                <div class="kpi-sub">Discount: ₹ @totalDiscount.ToString("N2")</div>
            }
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="kpi-label">Closing Balance</div>
            <div class="kpi-value fs-4 @(closingBalance > 0 ? "text-danger" : "text-success")">₹ @closingBalance.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="pb-card">
    <div class="pb-card-header">
        <h6 class="pb-card-title">Statement of Account (@fromDate to @toDate)</h6>
        <span class="badge bg-light text-dark">@Model.Count entries</span>
    </div>
    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0" id="ledgerTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Particulars / Type</th>
                    <th>Mode</th>
                    <th>Remarks</th>
                    <th class="text-end">Invoice Amt (Dr)</th>
                    <th class="text-end">Received / Paid (Cr)</th>
                    <th class="text-end">Discount</th>
                    <th class="text-end">Running Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted">No ledger transactions found in the selected date range.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TransactionDate</td>
                        <td class="fw-semibold">@t.TransactionType</td>
                        <td><span class="badge bg-light text-dark border">@(string.IsNullOrWhiteSpace(t.PaymentMode) ? "—" : t.PaymentMode)</span></td>
                        <td class="small text-muted">@t.Remarks</td>
                        <td class="text-end">@(t.InvoiceAmount > 0 ? $"₹ {t.InvoiceAmount:N2}" : "—")</td>
                        <td class="text-end text-success">@((t.ReceivedAmount + t.PaidAmount) > 0 ? $"₹ {(t.ReceivedAmount + t.PaidAmount):N2}" : "—")</td>
                        <td class="text-end">@(t.Discount > 0 ? $"₹ {t.Discount:N2}" : "—")</td>
                        <td class="text-end fw-bold">₹ @t.BalanceAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

