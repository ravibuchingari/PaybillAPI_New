@model List<ItemVM>
@{
    int ageDays = ViewBag.AgeDays is int d ? d : 30;
    ViewData["Title"] = $"Aged Inventory Report ({ageDays}+ Days)";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="btn-group">
        <a href="@Url.Action("AgedInventory", new { ageDays = 30 })" class="btn @(ageDays == 30 ? "btn-paybill" : "btn-outline-paybill")">30+ Days</a>
        <a href="@Url.Action("AgedInventory", new { ageDays = 60 })" class="btn @(ageDays == 60 ? "btn-paybill" : "btn-outline-paybill")">60+ Days</a>
        <a href="@Url.Action("AgedInventory", new { ageDays = 90 })" class="btn @(ageDays == 90 ? "btn-paybill" : "btn-outline-paybill")">90+ Days</a>
        <a href="@Url.Action("AgedInventory", new { ageDays = 180 })" class="btn @(ageDays == 180 ? "btn-paybill" : "btn-outline-paybill")">180+ Days</a>
    </div>

    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PaybillUI.exportTableToCsv('agedTable', 'Aged_Inventory_@(ageDays)Days.csv')">
        <i class="bi bi-download me-1"></i>Export CSV
    </button>
</div>

<div class="pb-card">
    <div class="pb-card-header">
        <h6 class="pb-card-title">Non-Moving / Aged Inventory (@Model.Count items older than @ageDays days)</h6>
    </div>
    <div class="table-responsive">
        <table class="table pb-table align-middle mb-0" id="agedTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th class="text-center">Current Stock</th>
                    <th class="text-end">Purchase Cost</th>
                    <th class="text-end">Sales Price</th>
                    <th class="text-end">Locked Capital (₹)</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted">No aged inventory items found for @ageDays+ days.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.ItemCode</code></td>
                        <td class="fw-semibold">@item.ItemName</td>
                        <td>@item.Category?.CategoryName</td>
                        <td class="text-center fw-bold">@item.Stock @item.Measure</td>
                        <td class="text-end">₹ @item.PurchasePrice.ToString("N2")</td>
                        <td class="text-end">₹ @item.SalesPrice.ToString("N2")</td>
                        <td class="text-end fw-bold text-danger">₹ @((item.Stock * item.PurchasePrice).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

