@model SetupAccountViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initial Business Setup | PayBill Cloud ERP</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/paybill.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .setup-card {
            max-width: 720px;
            width: 100%;
            background: #ffffff;
            border: 1px solid #dfecdf;
            border-radius: 24px;
            padding: 2.25rem 2.5rem;
            box-shadow: 0 20px 50px -15px rgba(34, 107, 8, 0.10), 0 8px 20px -8px rgba(24, 43, 25, 0.05);
        }
    </style>
</head>
<body>
    <div class="setup-card">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="pb-brand-logo-box">
                    <img src="~/images/logo.png" alt="PayBill" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                    <span style="display:none;">pb</span>
                </div>
                <div>
                    <h4 class="fw-bold mb-0" style="color:#153808;">First-Time Business &amp; Admin Setup</h4>
                    <p class="text-muted small mb-0">Initialize your PayBill business profile and administrator account</p>
                </div>
            </div>
            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small rounded-3">@Model.ErrorMessage</div>
        }

        <form asp-action="Setup" method="post">
            @Html.AntiForgeryToken()
            <h6 class="fw-bold text-uppercase small text-primary pb-2 mb-3 border-bottom">1. Business Profile</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label class="form-label">Business / Company Name <span class="text-danger">*</span></label>
                    <input asp-for="ClientName" class="form-control" placeholder="e.g., Geva Technologies" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Business Category <span class="text-danger">*</span></label>
                    <input asp-for="BusinessType" class="form-control" placeholder="e.g., Retail / Supermarket" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mobile Number (10 digits) <span class="text-danger">*</span></label>
                    <input asp-for="Mobile" class="form-control" maxlength="10" placeholder="10-digit mobile number" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="business@example.com" />
                </div>
                <div class="col-12">
                    <label class="form-label">Business Address <span class="text-danger">*</span></label>
                    <input asp-for="Address" class="form-control" placeholder="Door No, Street, City, State, PIN" required />
                </div>
            </div>

            <h6 class="fw-bold text-uppercase small text-primary pb-2 mb-3 border-bottom">2. Administrator Credentials</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                    <input asp-for="AdminFirstName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                    <input asp-for="AdminLastName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admin User ID <span class="text-danger">*</span></label>
                    <input asp-for="AdminUserId" class="form-control fw-bold" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admin Password <span class="text-danger">*</span></label>
                    <input asp-for="AdminPassword" type="password" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                <i class="bi bi-check2-circle me-1"></i> Complete Setup &amp; Continue
            </button>
        </form>
    </div>
</body>
</html>
