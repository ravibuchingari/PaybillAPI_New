<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Print Preview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #f6fbf6 0%, #eaf4ea 50%, #f3f8fb 100%);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #182b19;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .print-toolbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            color: #153808;
            border-bottom: 1px solid #d5e9d1;
            padding: 0.65rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 16px rgba(34, 107, 8, 0.08);
        }
        .print-sheet-a4, .print-a4 {
            background: #fff;
            width: 210mm;
            min-height: 297mm;
            margin: 24px auto;
            padding: 12mm 14mm;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            box-sizing: border-box;
            border-radius: 4px;
        }
        .print-sheet-pos80, .print-pos-80 {
            background: #fff;
            width: 80mm;
            margin: 24px auto;
            padding: 5mm;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
            font-size: 11.5px;
            line-height: 1.3;
            box-sizing: border-box;
            border-radius: 4px;
        }
        .print-sheet-pos58, .print-pos-58 {
            background: #fff;
            width: 58mm;
            margin: 24px auto;
            padding: 3mm;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
            font-size: 10.5px;
            line-height: 1.25;
            box-sizing: border-box;
            border-radius: 4px;
        }
        .pos-divider {
            border-top: 1px dashed #444;
            margin: 6px 0;
        }
        .pos-divider-double {
            border-top: 1px double #222;
            margin: 6px 0;
        }
        @@media print {
            @@page {
                margin: 6mm;
                size: auto;
            }
            body {
                background: #fff !important;
                color: #000 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print, .print-toolbar {
                display: none !important;
            }
            .print-sheet-a4, .print-a4, .print-sheet-pos80, .print-pos-80, .print-sheet-pos58, .print-pos-58 {
                margin: 0 !important;
                box-shadow: none !important;
                width: 100% !important;
                min-height: auto !important;
                padding: 0 !important;
                border-radius: 0 !important;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

