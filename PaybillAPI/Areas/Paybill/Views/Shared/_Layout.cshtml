@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var userFullName = User.FindFirstValue("FullName") ?? User.Identity?.Name ?? "User";
    var userId = User.FindFirstValue("UserId") ?? "";
    var isAdmin = User.IsInRole("admin");
    var companyName = User.FindFirstValue("CompanyName") ?? "PayBill POS & ERP";
    var companyGstin = User.FindFirstValue("CompanyGstin") ?? "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName | PayBill ERP</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/paybill.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="pb-wrapper">
        <!-- Left Collapsible Sidebar -->
        <aside class="pb-sidebar">
            <a href="@Url.Action("Index", "Dashboard")" class="pb-brand">
                <div class="pb-brand-logo-box">
                    <img src="~/images/logo.png" alt="PayBill" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                    <span style="display:none;">pb</span>
                </div>
                <div class="pb-brand-text overflow-hidden">
                    <div class="pb-brand-title text-truncate">@companyName</div>
                    <div class="pb-brand-subtitle">PayBill Cloud ERP</div>
                </div>
            </a>

            <nav class="pb-sidebar-nav">
                <div class="pb-nav-section">Overview</div>
                <a href="@Url.Action("Index", "Dashboard")" class="pb-nav-link @(currentController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span class="pb-nav-text">Dashboard</span>
                </a>

                <div class="pb-nav-section">Sales &amp; Service</div>
                <a href="@Url.Action("Create", "Sales")" class="pb-nav-link @(currentController == "Sales" && currentAction == "Create" ? "active" : "")">
                    <i class="bi bi-cart-plus-fill"></i>
                    <span class="pb-nav-text">New Sales POS <span class="badge bg-light text-dark ms-auto">F2</span></span>
                </a>
                <a href="@Url.Action("Index", "Sales")" class="pb-nav-link @(currentController == "Sales" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="pb-nav-text">Sales Invoices</span>
                </a>
                <a href="@Url.Action("Index", "JobCard")" class="pb-nav-link @(currentController == "JobCard" ? "active" : "")">
                    <i class="bi bi-tools"></i>
                    <span class="pb-nav-text">Service / Job Cards</span>
                </a>

                <div class="pb-nav-section">Procurement</div>
                <a href="@Url.Action("Create", "Purchase")" class="pb-nav-link @(currentController == "Purchase" && currentAction == "Create" ? "active" : "")">
                    <i class="bi bi-bag-plus-fill"></i>
                    <span class="pb-nav-text">New Purchase <span class="badge bg-light text-dark ms-auto">F4</span></span>
                </a>
                <a href="@Url.Action("Index", "Purchase")" class="pb-nav-link @(currentController == "Purchase" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-bag-check-fill"></i>
                    <span class="pb-nav-text">Purchase Register</span>
                </a>
                <a href="@Url.Action("Index", "PurchaseOrder")" class="pb-nav-link @(currentController == "PurchaseOrder" ? "active" : "")">
                    <i class="bi bi-clipboard2-check-fill"></i>
                    <span class="pb-nav-text">Purchase Orders</span>
                </a>

                <div class="pb-nav-section">Master Registrations</div>
                <a href="@Url.Action("Index", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-database-fill-gear"></i>
                    <span class="pb-nav-text">Master Setup Hub</span>
                </a>
                <a href="@Url.Action("Categories", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "Categories" ? "active" : "")">
                    <i class="bi bi-tags-fill"></i>
                    <span class="pb-nav-text">Category Master</span>
                </a>
                <a href="@Url.Action("Gst", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "Gst" ? "active" : "")">
                    <i class="bi bi-percent"></i>
                    <span class="pb-nav-text">GST Master</span>
                </a>
                <a href="@Url.Action("ItemMaster", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "ItemMaster" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span class="pb-nav-text">Item Master (Add/Edit)</span>
                </a>
                <a href="@Url.Action("Items", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "Items" ? "active" : "")">
                    <i class="bi bi-boxes"></i>
                    <span class="pb-nav-text">View All Items</span>
                </a>
                <a href="@Url.Action("PartyMaster", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "PartyMaster" ? "active" : "")">
                    <i class="bi bi-person-plus-fill"></i>
                    <span class="pb-nav-text">Party / Vendor Master</span>
                </a>
                <a href="@Url.Action("ServiceTypes", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "ServiceTypes" ? "active" : "")">
                    <i class="bi bi-wrench-adjustable-circle-fill"></i>
                    <span class="pb-nav-text">Service Types Master</span>
                </a>
                @if (isAdmin)
                {
                    <a href="@Url.Action("Users", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "Users" ? "active" : "")">
                        <i class="bi bi-person-badge-fill"></i>
                        <span class="pb-nav-text">User Registration</span>
                    </a>
                    <a href="@Url.Action("ImportData", "Master")" class="pb-nav-link @(currentController == "Master" && currentAction == "ImportData" ? "active" : "")">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                        <span class="pb-nav-text">Import Data (Excel)</span>
                    </a>
                }

                <div class="pb-nav-section">Inventory &amp; Parties</div>
                <a href="@Url.Action("Index", "Inventory")" class="pb-nav-link @(currentController == "Inventory" ? "active" : "")">
                    <i class="bi bi-clipboard-data-fill"></i>
                    <span class="pb-nav-text">Inventory Overview</span>
                </a>
                <a href="@Url.Action("Index", "Party", new { isVendor = false })" class="pb-nav-link @(currentController == "Party" && Context.Request.Query["isVendor"] != "true" && Context.Request.Query["isVendor"] != "True" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span class="pb-nav-text">Customers List</span>
                </a>
                <a href="@Url.Action("Index", "Party", new { isVendor = true })" class="pb-nav-link @(currentController == "Party" && (Context.Request.Query["isVendor"] == "true" || Context.Request.Query["isVendor"] == "True") ? "active" : "")">
                    <i class="bi bi-buildings-fill"></i>
                    <span class="pb-nav-text">Suppliers / Vendors</span>
                </a>

                <div class="pb-nav-section">Payments &amp; Cash</div>
                <a href="@Url.Action("Index", "Transaction", new { isPayment = false })" class="pb-nav-link @(currentController == "Transaction" && Context.Request.Query["isPayment"] != "true" && Context.Request.Query["isPayment"] != "True" ? "active" : "")">
                    <i class="bi bi-arrow-down-left-circle-fill"></i>
                    <span class="pb-nav-text">Customer Receipts (In)</span>
                </a>
                <a href="@Url.Action("Index", "Transaction", new { isPayment = true })" class="pb-nav-link @(currentController == "Transaction" && (Context.Request.Query["isPayment"] == "true" || Context.Request.Query["isPayment"] == "True") ? "active" : "")">
                    <i class="bi bi-arrow-up-right-circle-fill"></i>
                    <span class="pb-nav-text">Payments / Expenses (Out)</span>
                </a>

                <div class="pb-nav-section">Tax, Loyalty &amp; Reports</div>
                <a href="@Url.Action("GstReturns", "Report")" class="pb-nav-link @(currentController == "Report" && currentAction == "GstReturns" ? "active" : "")">
                    <i class="bi bi-bank2"></i>
                    <span class="pb-nav-text">GST &amp; Tax Returns</span>
                </a>
                <a href="@Url.Action("Index", "Reward")" class="pb-nav-link @(currentController == "Reward" ? "active" : "")">
                    <i class="bi bi-gift-fill"></i>
                    <span class="pb-nav-text">Loyalty &amp; Rewards</span>
                </a>
                <a href="@Url.Action("Index", "Report")" class="pb-nav-link @(currentController == "Report" && currentAction != "GstReturns" ? "active" : "")">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span class="pb-nav-text">Reports &amp; Analytics</span>
                </a>

                <div class="pb-nav-section">Administration</div>
                <a href="@Url.Action("Index", "Settings")" class="pb-nav-link @(currentController == "Settings" ? "active" : "")">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span class="pb-nav-text">Settings &amp; Users</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="pb-main">
            <!-- Top Navigation Bar -->
            <header class="pb-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PayBillUI.toggleSidebar()" title="Toggle Sidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
                        @if (!string.IsNullOrWhiteSpace(companyGstin))
                        {
                            <small class="text-muted">GSTIN: <span class="fw-semibold">@companyGstin</span></small>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Quick Actions -->
                    <a href="@Url.Action("Create", "Sales")" class="btn btn-sm btn-primary d-none d-md-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-lg"></i> New Sale (F2)
                    </a>
                    <a href="@Url.Action("Create", "JobCard")" class="btn btn-sm btn-outline-primary d-none d-lg-inline-flex align-items-center gap-1">
                        <i class="bi bi-tools"></i> + Job Card
                    </a>
                    <a href="@Url.Action("Create", "Purchase")" class="btn btn-sm btn-outline-primary d-none d-lg-inline-flex align-items-center gap-1">
                        <i class="bi bi-bag-plus"></i> + Purchase
                    </a>
                    <a href="@Url.Action("Index", "Transaction", new { isPayment = false })" class="btn btn-sm btn-outline-primary d-none d-xl-inline-flex align-items-center gap-1">
                        <i class="bi bi-cash-coin"></i> + Receipt
                    </a>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-6 text-primary"></i>
                            <span class="d-none d-sm-inline fw-semibold">@userFullName</span>
                            <span class="badge @(isAdmin ? "badge-soft badge-soft-success" : "badge-soft badge-soft-secondary")">@(isAdmin ? "Admin" : "Staff")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">
                                <div class="fw-bold">@userFullName</div>
                                <div class="small text-muted">User ID: @userId</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Index", "Settings", new { tab = "profile" })">
                                    <i class="bi bi-building me-2"></i>Business Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Index", "Settings", new { tab = "password" })">
                                    <i class="bi bi-key me-2"></i>Change Password
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Index", "Settings", new { tab = "unlock" })">
                                        <i class="bi bi-unlock me-2"></i>Unlock Requests
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger fw-semibold">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="pb-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="px-4 py-2 border-top small text-muted d-flex justify-content-between align-items-center">
                <span>&copy; @DateTime.Now.Year <strong>@companyName</strong> — Powered by PayBill Enterprise POS &amp; ERP</span>
                <span>Shortcuts: <kbd>F2</kbd> Sales POS &bull; <kbd>F4</kbd> Purchase</span>
            </footer>
        </div>
    </div>

    <!-- Global Toast Notification Container -->
    <div id="pbToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

    <!-- Global Confirmation & Audit Remarks Modal -->
    <div class="modal fade" id="pbConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="pbConfirmTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="pbConfirmMessage" class="mb-2">Are you sure you want to proceed?</p>
                    <div id="pbConfirmRemarksWrap" class="mt-3 d-none">
                        <label class="form-label fw-semibold">Audit Remarks / Reason <span class="text-danger">*</span></label>
                        <textarea id="pbConfirmRemarks" class="form-control" rows="2" placeholder="Enter mandatory reason for audit log..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="pbConfirmOkBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="~/js/paybill.js" asp-append-version="true"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                PayBillUI.toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])), 'success');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                PayBillUI.toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])), 'danger');
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

