<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Paybill</AssemblyName>
    <RootNamespace>Paybill</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Areas\WebApi\Controllers\" />
    <Folder Include="Areas\Paybill\Controllers\" />
    <Folder Include="Areas\Paybill\Models\" />
    <Folder Include="Areas\Paybill\Views\" />
    <Folder Include="wwwroot\applog\" />
    <Folder Include="wwwroot\temp\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MySql.Data" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JWTAuthenticationManager\AuthenticationManager.csproj" />
  </ItemGroup>
</Project>

