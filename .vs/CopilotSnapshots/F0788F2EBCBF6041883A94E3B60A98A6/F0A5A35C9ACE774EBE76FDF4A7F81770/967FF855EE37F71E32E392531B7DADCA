<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Paybill</AssemblyName>
    <RootNamespace>Paybill</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\log\**" />
    <Content Remove="wwwroot\applog\**" />
    <Content Remove="wwwroot\temp\**" />
    <Folder Include="Areas\Paybill\Controllers\" />
    <Folder Include="Areas\Paybill\Views\" />
    <Folder Include="wwwroot\applog\" />
    <Folder Include="wwwroot\temp\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MySql.Data" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="itext7" />
    <PackageReference Include="itext7.html2pdf" />
  </ItemGroup>
</Project>

