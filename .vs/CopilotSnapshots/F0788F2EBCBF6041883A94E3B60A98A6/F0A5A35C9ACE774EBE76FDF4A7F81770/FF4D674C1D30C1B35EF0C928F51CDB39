using SelectPdf;

namespace Paybill.Services
{
    /// <summary>
    /// Service for converting HTML content to PDF using SelectPdf
    /// </summary>
    public class HtmlToPdfService
    {
        private readonly ILogger<HtmlToPdfService> _logger;

        public HtmlToPdfService(ILogger<HtmlToPdfService> logger)
        {
            _logger = logger;
        }

        /// <summary>
        /// Convert HTML string to PDF bytes
        /// </summary>
        /// <param name="htmlContent">HTML content to convert</param>
        /// <param name="baseUrl">Base URL for resolving relative paths (images, CSS, etc.)</param>
        /// <returns>PDF as byte array</returns>
        public async Task<byte[]> ConvertHtmlToPdfAsync(string htmlContent, string? baseUrl = null)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(htmlContent))
                {
                    throw new ArgumentException("HTML content cannot be empty", nameof(htmlContent));
                }

                return await Task.Run(() =>
                {
                    using (var converter = new HtmlToImage())
                    {
                        // Configure converter properties
                        converter.ConversionDelay = 2; // Allow time for resources to load
                        converter.JavaScriptEnabled = false; // Disable JavaScript for security
                        converter.CacheFolder = Path.Combine(Path.GetTempPath(), "SelectPdfCache");

                        // Set base URL for resolving relative resources (images, stylesheets, etc.)
                        if (!string.IsNullOrWhiteSpace(baseUrl))
                        {
                            converter.BaseUrl = baseUrl;
                        }

                        // Convert HTML to image bytes (as PDF)
                        byte[] imageBytes = converter.ConvertHtmlString(htmlContent, null);

                        if (imageBytes == null || imageBytes.Length == 0)
                        {
                            throw new InvalidOperationException("PDF conversion returned empty result");
                        }

                        return imageBytes;
                    }
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error converting HTML to PDF");
                throw new InvalidOperationException("Failed to convert HTML to PDF", ex);
            }
        }

        /// <summary>
        /// Convert HTML file to PDF bytes
        /// </summary>
        /// <param name="filePath">Full path to HTML file</param>
        /// <param name="baseUrl">Base URL for resolving relative paths</param>
        /// <returns>PDF as byte array</returns>
        public async Task<byte[]> ConvertHtmlFileToPdfAsync(string filePath, string? baseUrl = null)
        {
            try
            {
                if (!File.Exists(filePath))
                {
                    throw new FileNotFoundException("HTML file not found", filePath);
                }

                var htmlContent = await File.ReadAllTextAsync(filePath);
                return await ConvertHtmlToPdfAsync(htmlContent, baseUrl);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error converting HTML file {FilePath} to PDF", filePath);
                throw new InvalidOperationException($"Failed to convert HTML file to PDF: {filePath}", ex);
