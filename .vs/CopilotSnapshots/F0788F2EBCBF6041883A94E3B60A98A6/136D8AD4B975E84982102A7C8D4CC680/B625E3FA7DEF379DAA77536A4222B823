            if (mode === 'Credit') {
                if (partyId === 0) {
                    PaybillUI.showToast('Customer selection is mandatory for Credit invoices. Please select a registered customer.', 'warning');
                    partySel?.focus();
                }
                document.getElementById('ReceivedAmount').value = '0.00';
