        function updateBalanceAndChange() {
            const grandTotal = parseFloat(document.getElementById('lblGrandTotal').innerText.replace('₹', '').trim()) || 0;
            const received = parseFloat(document.getElementById('ReceivedAmount').value || '0') || 0;
            const tendered = parseFloat(document.getElementById('CashTenderedInput').value || '0') || 0;
            const el = document.getElementById('lblBalanceOrChange');

            if (tendered > grandTotal) {
                el.className = 'form-control form-control-sm bg-success-subtle text-success fw-bold';
                el.innerText = `Change: ₹ ${(tendered - grandTotal).toFixed(2)}`;
            } else {
                const bal = Math.max(0, grandTotal - received);
                el.className = `form-control form-control-sm bg-light fw-bold ${bal > 0 ? 'text-danger' : 'text-success'}`;
                el.innerText = `Bal: ₹ ${bal.toFixed(2)}`;
            }
        }

