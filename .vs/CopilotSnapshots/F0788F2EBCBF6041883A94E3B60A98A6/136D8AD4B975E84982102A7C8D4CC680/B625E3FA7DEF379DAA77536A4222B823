        async function saveInvoice(printAfter) {
            if (lineItems.length === 0) {
                PaybillUI.showToast('Please add at least one item to the invoice.', 'warning');
                return;
            }
            const partySel = document.getElementById('PartyId');
            const partyId = parseInt(partySel?.value || '0');
            const paymentMode = document.getElementById('PaymentMode')?.value;
            const isCredit = paymentMode === 'Credit' || document.getElementById('SalesType')?.value === 'Credit';

            if (isCredit && partyId <= 0) {
                updateCreditRequirements();
                partySel?.focus();
                PaybillUI.showToast('Customer selection is mandatory for Credit invoices. Please select a registered customer.', 'danger');
                return;
            }

            const grandTotal = parseFloat(document.getElementById('lblGrandTotal').innerText.replace('₹', '').trim()) || 0;
            const received = parseFloat(document.getElementById('ReceivedAmount').value || '0') || 0;
            const balance = Math.max(0, grandTotal - received);
            const roundOff = parseFloat(document.getElementById('lblRoundOff').innerText.replace('₹', '').replace('+', '').trim()) || 0;
            const extraDisc = parseFloat(document.getElementById('TotalSavings')?.value || '0') || 0;
            const ptsRedeemed = parseFloat(document.getElementById('PointsRedeemedInput')?.value || '0') || 0;
            const ptsDiscount = Number((ptsRedeemed * rewardsConfig.ptValue).toFixed(2));
            const ptsEarned = parseFloat(document.getElementById('PointsEarnedPreview')?.innerText || '0') || 0;

            const payload = {
                SalesId: salesId,
                InvoiceNumber: '@Model.Invoice.InvoiceNumber',
                SalesDate: document.getElementById('SalesDate').value,
                SalesType: document.getElementById('SalesType').value,
                PaymentMode: paymentMode,
                IsCashSales: paymentMode !== 'Credit',
                PartyId: partyId > 0 ? partyId : null,
                TotalTaxableAmount: lineItems.reduce((s, i) => s + i.taxableAmount, 0),
                TotalCgst: lineItems.reduce((s, i) => s + i.cgstAmount, 0),
                TotalSgst: lineItems.reduce((s, i) => s + i.sgstAmount, 0),
                TotalIgst: lineItems.reduce((s, i) => s + i.igstAmount, 0),
                TotalDiscount: lineItems.reduce((s, i) => s + (i.discountRs || 0), 0),
                TotalSavings: extraDisc,
                RoundOff: roundOff,
                TotalInvoiceAmount: grandTotal,
                ReceivedAmount: received,
                BalanceAmount: balance,
                Remarks: document.getElementById('Remarks').value,
                PointsEarned: ptsEarned,
                PointsRedeemed: ptsRedeemed,
                PointsDiscount: ptsDiscount,
                SalesItems: lineItems.map(i => ({
                    SalesItemId: i.salesItemId,
                    SalesId: salesId,
                    ItemId: i.itemId,
                    ServiceTypeId: i.serviceTypeId,
                    Quantity: i.quantity,
                    Mrp: i.mrp,
                    SalesPrice: i.salesPrice,
                    TaxableAmount: i.taxableAmount,
                    GstId: i.gstId,
                    CgstPer: i.cgstPer,
                    SgstPer: i.sgstPer,
                    IgstPer: i.igstPer,
                    CgstAmount: i.cgstAmount,
                    SgstAmount: i.sgstAmount,
                    IgstAmount: i.igstAmount,
                    DiscountPer: i.discountPer,
                    DiscountRs: i.discountRs,
                    TotalAmount: i.totalAmount
                }))
            };

            const btnSavePrint = document.getElementById('btnSavePrint');
            const btnSaveOnly = document.getElementById('btnSaveOnly');
            if (btnSavePrint) btnSavePrint.disabled = true;
            if (btnSaveOnly) btnSaveOnly.disabled = true;

            try {
                const res = await fetch('@Url.Action("SaveInvoice")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.isSuccess) {
                    PaybillUI.showToast(data.message || 'Sales invoice saved successfully!', 'success');
                    const finalId = data.salesId || data.SalesId || (parseInt(data.data || data.Data || '0')) || salesId;

                    if (printAfter && finalId > 0) {
                        const salesTypeVal = document.getElementById('SalesType')?.value || 'GST';
                        const selectedFormat = document.getElementById('directPrintFormatSelect')?.value || (salesTypeVal === 'Non-GST' ? 'A4_NONGST' : 'A4');

                        // 1. Direct print without preview via hidden background iframe
                        directPrintInvoice(finalId, selectedFormat);

                        // 2. Populate and display post-save success modal on billing screen
                        document.getElementById('savedModalInvNo').innerText = `#${finalId}`;
                        document.getElementById('savedModalAmount').innerText = document.getElementById('lblGrandTotal')?.innerText || '₹ 0.00';

                        const custSel = document.getElementById('PartyId');
                        const custText = custSel?.options[custSel.selectedIndex]?.text || 'Walk-in / Cash Customer';
                        document.getElementById('savedModalCustomer').innerText = custText.split('(')[0].trim();

                        const savedModalElement = document.getElementById('invoiceSavedModal');
                        const savedModal = new bootstrap.Modal(savedModalElement);

                        // Auto-focus the "New Invoice" button when modal is fully shown
                        savedModalElement.addEventListener('shown.bs.modal', function focusButton() {
                            const btnNewInvoice = document.getElementById('buttonNewInvoice');
                            btnNewInvoice?.focus();

                            // Handle Enter key to click the focused button
                            const handleEnter = (e) => {
                                if (e.key === 'Enter' && document.activeElement === btnNewInvoice) {
                                    e.preventDefault();
                                    btnNewInvoice.click();
                                }
                            };
                            savedModalElement.addEventListener('keydown', handleEnter);

                            // Clean up listener when modal is hidden
                            const cleanupListener = () => {
                                savedModalElement.removeEventListener('keydown', handleEnter);
                                savedModalElement.removeEventListener('hidden.bs.modal', cleanupListener);
                            };
                            savedModalElement.addEventListener('hidden.bs.modal', cleanupListener);
                        }, { once: true });

                        savedModal.show();

                        if (btnSavePrint) btnSavePrint.disabled = false;
                        if (btnSaveOnly) btnSaveOnly.disabled = false;
                    } else {
                        window.location.href = '@Url.Action("Index")';
                    }
                } else {
                    PaybillUI.showToast(data.message || 'Failed to save invoice.', 'danger');
                    if (btnSavePrint) btnSavePrint.disabled = false;
                    if (btnSaveOnly) btnSaveOnly.disabled = false;
                }
            } catch (err) {
                PaybillUI.showToast('Network error saving invoice.', 'danger');
                if (btnSavePrint) btnSavePrint.disabled = false;
                if (btnSaveOnly) btnSaveOnly.disabled = false;
            }
        }

        let lastSavedInvoiceId = 0;
        let lastSavedInvoiceFormat = 'A4';

        function directPrintInvoice(salesId, format) {
            lastSavedInvoiceId = salesId;
            lastSavedInvoiceFormat = format;

            let iframe = document.getElementById('directPrintIframe');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'directPrintIframe';
                iframe.name = 'directPrintIframe';
                iframe.style.position = 'fixed';
                iframe.style.right = '0';
                iframe.style.bottom = '0';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = '0';
                iframe.style.visibility = 'hidden';
                document.body.appendChild(iframe);
            }

            const printUrl = `@Url.Action("Print")?id=${salesId}&format=${format}&autoprint=1`;

            let hasPrinted = false;
            iframe.onload = function () {
                if (hasPrinted) return;
                hasPrinted = true;
                setTimeout(function () {
                    try {
                        iframe.contentWindow.focus();
                        iframe.contentWindow.print();
                    } catch (e) {
                        console.warn('Direct iframe print error:', e);
                    }
                }, 250);
            };

            iframe.src = printUrl;
        }

        function reprintSavedInvoice() {
            if (lastSavedInvoiceId > 0) {
                directPrintInvoice(lastSavedInvoiceId, lastSavedInvoiceFormat);
            }
        }

        function viewSavedInvoice() {
            if (lastSavedInvoiceId > 0) {
                window.open(`@Url.Action("Print")?id=${lastSavedInvoiceId}&format=${lastSavedInvoiceFormat}`, '_blank');
            }
        }

        function savePreferredPrintFormat(fmt) {
            localStorage.setItem('paybill_direct_print_format', fmt);
        }
    </script>
}

