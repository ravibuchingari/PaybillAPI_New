        function addCatalogItem(item, qty, customRate = null) {
            const existing = lineItems.find(x => x.itemId === item.ItemId && customRate === null);
            if (existing) {
                existing.quantity = Number((existing.quantity + qty).toFixed(3));
            } else {
                const gstPer = (item.Gst?.CgstPer || 0) + (item.Gst?.SgstPer || 0);
                const price = customRate !== null ? customRate : item.SalesPrice;
                const discRs = item.DiscountPer > 0 ? Number(((price * qty * item.DiscountPer) / 100).toFixed(2)) : (item.DiscountRs || 0);
                lineItems.push({
                    salesItemId: 0,
                    itemId: item.ItemId,
                    serviceTypeId: null,
                    itemCode: item.ItemCode,
                    itemName: item.ItemName,
                    measure: item.Measure || 'NOS',
                    hsnCode: item.HsnCode || '',
                    quantity: qty,
                    salesPrice: price,
                    mrp: item.Mrp || price,
                    discountPer: item.DiscountPer || 0,
                    discountRs: discRs,
                    gstId: item.GstId || 1,
                    gstPer: gstPer,
                    isGstInclusive: !!item.IsGstInclusive
                });
            }
            recalculateAll();
        }

        function updateLineQty(idx, val) {
            const q = parseFloat(val);
            if (q > 0) {
                lineItems[idx].quantity = q;
                recalculateAll();
            }
        }

        function updateLineRate(idx, val) {
            const r = parseFloat(val);
            if (r >= 0) {
                lineItems[idx].salesPrice = r;
                recalculateAll();
            }
        }

        function updateLineDiscount(idx, val) {
            const d = parseFloat(val);
            lineItems[idx].discountRs = isNaN(d) || d < 0 ? 0 : d;
            recalculateAll();
        }

        async function removeLineItem(idx) {
            const row = lineItems[idx];
            if (row.salesItemId > 0) {
                if (isLocked) {
                    PaybillUI.showToast('This invoice is locked. Please request an unlock before deleting saved items.', 'warning');
                    return;
                }
                const remarks = prompt('Enter mandatory audit reason for deleting this saved invoice item:');
                if (!remarks || !remarks.trim()) return;

                const fd = new URLSearchParams({ salesItemId: row.salesItemId, remarks: remarks.trim() });
                const res = await fetch('@Url.Action("DeleteItem")', { method: 'POST', body: fd });
                const data = await res.json();
                if (!data.isSuccess) {
                    PaybillUI.showToast(data.message || 'Could not delete item.', 'danger');
                    return;
                }
                PaybillUI.showToast('Saved line item removed.', 'success');
            }
            lineItems.splice(idx, 1);
            recalculateAll();
        }

        function recalculateAll() {
            const isGstBill = document.getElementById('SalesType').value === 'GST';
            const interState = isInterStateSupply();
            const tbody = document.getElementById('invoiceItemsBody');

            let totalTaxable = 0;
            let totalCgst = 0;
            let totalSgst = 0;
            let totalIgst = 0;
            let totalItemDisc = 0;
            let totalQty = 0;

            if (lineItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-upc-scan fs-2 d-block mb-2"></i>Scan a barcode or search an item above to start billing.</td></tr>`;
            } else {
                tbody.innerHTML = lineItems.map((item, idx) => {
                    const gross = item.quantity * item.salesPrice;
                    const disc = item.discountRs || 0;
                    const netBeforeOrWithTax = Math.max(0, gross - disc);
                    const effGstPer = isGstBill ? (item.gstPer || 0) : 0;

                    let taxable = netBeforeOrWithTax;
                    let taxAmt = 0;
                    if (effGstPer > 0) {
                        if (item.isGstInclusive) {
                            taxable = netBeforeOrWithTax / (1 + effGstPer / 100);
                            taxAmt = netBeforeOrWithTax - taxable;
                        } else {
                            taxable = netBeforeOrWithTax;
                            taxAmt = (taxable * effGstPer) / 100;
                        }
                    }

                    const lineTotal = taxable + taxAmt;
                    item.taxableAmount = Number(taxable.toFixed(2));
                    if (interState) {
                        item.cgstPer = 0; item.sgstPer = 0; item.igstPer = effGstPer;
                        item.cgstAmount = 0; item.sgstAmount = 0; item.igstAmount = Number(taxAmt.toFixed(2));
                    } else {
                        item.cgstPer = effGstPer / 2; item.sgstPer = effGstPer / 2; item.igstPer = 0;
                        item.cgstAmount = Number((taxAmt / 2).toFixed(2));
                        item.sgstAmount = Number((taxAmt / 2).toFixed(2));
                        item.igstAmount = 0;
                    }
                    item.totalAmount = Number(lineTotal.toFixed(2));

                    totalTaxable += item.taxableAmount;
                    totalCgst += item.cgstAmount;
                    totalSgst += item.sgstAmount;
                    totalIgst += item.igstAmount;
                    totalItemDisc += disc;
                    totalQty += item.quantity;

                    return `
                        <tr>
                            <td class="text-muted text-center" style="width: 32px;">${idx + 1}</td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width: 220px;" title="${item.itemName}">${item.itemName}</div>
                                <div class="small text-muted">${item.itemCode} ${item.hsnCode ? '| HSN: ' + item.hsnCode : ''} ${item.measure ? '| ' + item.measure : ''}</div>
                            </td>
                            <td class="text-center" style="width: 78px;">
                                <input type="number" step="any" min="0.001" class="form-control form-control-sm pos-input-qty" value="${item.quantity}" onchange="updateLineQty(${idx}, this.value)" />
                            </td>
                            <td class="text-end" style="width: 90px;">
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm pos-input-rate" value="${item.salesPrice}" onchange="updateLineRate(${idx}, this.value)" />
                            </td>
                            <td class="text-end" style="width: 75px;">
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm pos-input-disc" value="${item.discountRs}" onchange="updateLineDiscount(${idx}, this.value)" />
                            </td>
                            <td class="text-center" style="width: 58px;"><span class="badge bg-light text-dark border">${effGstPer}%</span></td>
                            <td class="text-end text-nowrap" style="width: 82px; font-size: 0.88rem;">₹ ${(item.cgstAmount + item.sgstAmount + item.igstAmount).toFixed(2)}</td>
                            <td class="text-end text-nowrap fw-bold" style="width: 98px;">₹ ${item.totalAmount.toFixed(2)}</td>
                            <td class="text-center" style="width: 38px;">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;" onclick="removeLineItem(${idx})" title="Remove"><i class="bi bi-x-lg"></i></button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            document.getElementById('itemCountBadge').innerText = lineItems.length;
            document.getElementById('lblTotalQtyBadge').innerText = `${totalQty.toFixed(2)} Qty`;
            document.getElementById('lblTaxableTotal').innerText = `₹ ${totalTaxable.toFixed(2)}`;
            document.getElementById('lblCgstTotal').innerText = `₹ ${totalCgst.toFixed(2)}`;
            document.getElementById('lblSgstTotal').innerText = `₹ ${totalSgst.toFixed(2)}`;
            document.getElementById('lblIgstTotal').innerText = `₹ ${totalIgst.toFixed(2)}`;
            document.getElementById('lblItemDiscountTotal').innerText = `- ₹ ${totalItemDisc.toFixed(2)}`;

            document.getElementById('rowCgstSgst').classList.toggle('d-none', interState);
            document.getElementById('rowIgst').classList.toggle('d-none', !interState);

            const extraDisc = parseFloat(document.getElementById('TotalSavings')?.value || '0') || 0;

            let pointsRedeemed = 0;
            let pointsDiscount = 0;
            if (rewardsConfig.enabled && document.getElementById('PointsRedeemedInput')) {
                pointsRedeemed = parseFloat(document.getElementById('PointsRedeemedInput').value || '0') || 0;
                if (pointsRedeemed > customerAvailablePoints && salesId === 0) {
                    pointsRedeemed = customerAvailablePoints;
                    document.getElementById('PointsRedeemedInput').value = pointsRedeemed;
                }
                pointsDiscount = Number((pointsRedeemed * rewardsConfig.ptValue).toFixed(2));
                document.getElementById('PointsDiscountDisplay').innerText = `-₹${pointsDiscount.toFixed(2)}`;
            }

            const rawGrandTotal = Math.max(0, totalTaxable + totalCgst + totalSgst + totalIgst - extraDisc - pointsDiscount);
            const roundedGrandTotal = Math.round(rawGrandTotal);
            const roundOff = Number((roundedGrandTotal - rawGrandTotal).toFixed(2));

            document.getElementById('lblRoundOff').innerText = `${roundOff >= 0 ? '+' : ''}₹ ${roundOff.toFixed(2)}`;
            document.getElementById('lblGrandTotal').innerText = `₹ ${roundedGrandTotal.toFixed(2)}`;

            // Points earned preview
            if (rewardsConfig.enabled && document.getElementById('PointsEarnedPreview')) {
                let earned = 0;
                const partyId = parseInt(document.getElementById('PartyId').value || '0');
                if (partyId > 0 && roundedGrandTotal >= rewardsConfig.minInvoiceAmt) {
                    earned = Math.floor((roundedGrandTotal / 100.0) * rewardsConfig.ptsPer100);
                }
                document.getElementById('PointsEarnedPreview').innerText = earned;
            }

            const mode = document.getElementById('PaymentMode').value;
            if (mode !== 'Credit' && salesId === 0) {
                document.getElementById('ReceivedAmount').value = roundedGrandTotal.toFixed(2);
            } else if (mode === 'Credit' && salesId === 0) {
                document.getElementById('ReceivedAmount').value = '0.00';
            }

            updateBalanceAndChange();
        }

        function onPaymentModeChanged() {
            const mode = document.getElementById('PaymentMode').value;
            const grandTotal = parseFloat(document.getElementById('lblGrandTotal').innerText.replace('₹', '').trim()) || 0;
            const partySel = document.getElementById('PartyId');
